# Copiá este archivo como ".env" (sin "ejemplo") y completá los valores. Nunca lo compartas: tiene claves secretas.
# Supabase > Project Settings > API
SUPABASE_URL=https://trroercvimupqlpbvndx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio > Get API key (la misma que cargaste en Netlify)
GEMINI_API_KEY=
# La dirección de tu menú (Mi negocio > Menú de pedidos)
WA_SLUG=venutto
# Opcional: el número del WhatsApp que va a atender el bot, con código de país (ej 5493855702807).
# Si lo ponés, en vez del QR te da un código de 8 letras para vincular (más fácil si la ventana no muestra bien el QR).
WA_NUMERO=
# Solo para probar fuera del horario de atención: poné 1 y el bot contesta aunque esté cerrado. Después borralo.
WA_IGNORAR_HORARIO=
